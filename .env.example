# ============================================================
# Furki Cycle — Exemplo de Configuração (template)
# Copie para .env somente no servidor de execução.
# Substitua os valores ilustrativos pelos reais.
# NUNCA versione o arquivo .env real.
# ============================================================

# ---------- APLICAÇÃO ----------
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://seu-dominio.example
JWT_SECRET=gere-um-segredo-longo-e-aleatorio-com-no-minimo-32-caracteres
JWT_ISSUER=furki-cycle
JWT_EXPIRATION_SECONDS=3600
# Proteção contra força bruta no login (opcionais; valores abaixo são os padrões)
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=30
LOGIN_LOCK_MINUTES=15
# CORS fica DESLIGADO por padrão (front e API são da mesma origem). Só defina se
# precisar liberar outra origem; lista separada por vírgula, ex.: https://app.exemplo.com
CORS_ALLOWED_ORIGINS=

# ---------- MYSQL (Banco de Controle) ----------
MYSQL_HOST=host-do-mysql
MYSQL_PORT=3306
MYSQL_DATABASE=furki_cycle
MYSQL_USERNAME=usuario_mysql
MYSQL_PASSWORD=senha_mysql
MYSQL_CHARSET=utf8mb4

# ---------- MYSQL (Banco Estrangeiro) ----------
# Por padrão usa o mesmo host/porta/usuário/senha do MYSQL de controle; apenas o
# banco muda. Se o banco estrangeiro estiver em OUTRO host, defina FOREIGN_DB_HOST
# (e FOREIGN_DB_PORT / FOREIGN_DB_USERNAME / FOREIGN_DB_PASSWORD, se necessário).
FOREIGN_DB_NAME=exemplo_bi_insight
FOREIGN_DB_CHARSET=utf8mb4
# FOREIGN_DB_HOST=host-do-banco-estrangeiro
# FOREIGN_DB_PORT=3306
# FOREIGN_DB_USERNAME=
# FOREIGN_DB_PASSWORD=

# ---------- GATE (MSSQL) ----------
GATE_DB_DRIVER=sqlsrv
GATE_DB_HOST=host-do-gate
GATE_DB_PORT=1433
GATE_DB_NAME=nome_do_gate
GATE_DB_USER=usuario_do_gate
GATE_DB_PASSWORD=senha_do_gate
GATE_DB_CHARSET=utf8
# Opcional: views do GATE usadas pelo Rebooking. Padrao dbo.Rebooking (ambas). Para usar a view ENXUTA
# (docs/ai/analise-view-rebooking-gate.md) crie dbo.RebookingApi no GATE e defina GATE_REBOOKING_VIEW=dbo.RebookingApi
# (grid, contagem e consulta por nota). O "Ver tabela GATE" continua na view completa (GATE_REBOOKING_EXT_VIEW).
# Sincronização Consolidada: dias por bloco (1 a 10; padrão 5). Cada bloco processa as 4 tabelas e grava o ponto de retomada.
# SYNC_JOB_BLOCK_DAYS=5

# Fonte de leitura do Rebooking: "interna" (padrão; lê wg_ven/wgfor/wgcli com as regras da tela Configurações)
# ou "view" (volta a ler a view abaixo — use como rollback). As duas variáveis de view só valem com GATE_REBOOKING_FONTE=view.
# GATE_REBOOKING_FONTE=interna
# GATE_REBOOKING_VIEW=dbo.Rebooking
# GATE_REBOOKING_EXT_VIEW=dbo.Rebooking

# ---------- FURK.CYCLE ----------
FURK_ENVIRONMENT=production
FURK_CLIENT_ID=preencher_no_servidor
FURK_CLIENT_SECRET=preencher_no_servidor
FURK_API_KEY=preencher_no_servidor
FURK_WEBHOOK_IDENTIFICATION_TOKEN=preencher_no_servidor
FURK_TOKEN_URL=https://auth-api.furk.tech/oauth2/token
FURK_CREDITS_URL=https://cycle-api.furk.tech/v1/credit/eligible
FURK_CREDITS_SCOPE=furkcycle-api-modules/credits
FURK_DYNAMIC_STATUS_URL=https://cycle-api.furk.tech/v1/dynamicstatus
FURK_DYNAMIC_STATUS_SCOPE=furkcycle-api-modules/dynamic-status furkcycle-api-modules/credits furkcycle-api-modules/refund
FURK_REBOOKING_URL=https://rebooking-api.furk.tech/v1/rebooking
FURK_REBOOKING_SCOPE=furkcycle-api-modules/rebooking
FURK_REBOOKING_CLIENT_ID=preencher_no_servidor
FURK_REBOOKING_CLIENT_SECRET=preencher_no_servidor
FURK_REBOOKING_API_KEY=preencher_no_servidor
# ⚠️ VALORES DE TESTE — NÃO usar em envio real. O canal correto é AZUL (Azul Linhas Aéreas).
FURK_ISSUE_CHANNEL=SABRE
FURK_IATA_CODE=0000000
FURK_WEBHOOK_URL=https://seu-dominio.example/api/webhooks/furk/rebooking

# ---------- REFUND (Reembolsos Elegíveis) ----------
FURK_REFUND_URL=https://cycle-api.furk.tech/v1/refund/eligible
FURK_REFUND_REQUEST_URL=https://cycle-api.furk.tech/v1/refund/request
FURK_REFUND_SCOPE=furkcycle-api-modules/refund
FURK_REFUND_CLIENT_ID=preencher_no_servidor
FURK_REFUND_CLIENT_SECRET=preencher_no_servidor
FURK_REFUND_API_KEY=preencher_no_servidor
FURK_REFUND_PAGE_SIZE=100
FURK_REFUND_MAX_PAGES=1000
FURK_REFUND_DELAY_MS=100
FURK_REFUND_MAX_RETRIES=3

# ---------- SALES (Vendas) ----------
# Reutiliza FURK_CLIENT_ID, FURK_CLIENT_SECRET, FURK_API_KEY e FURK_TOKEN_URL.
FURK_SALES_URL=https://cycle-api.furk.tech/v1/sales
FURK_SALES_SCOPE=furkcycle-api-modules/sales
FURK_SALES_PAGE_SIZE=100
FURK_SALES_MAX_PAGES=1000
FURK_SALES_DELAY_MS=100
FURK_SALES_MAX_RETRIES=3

# ---------- OPERAÇÃO ----------
FURK_REQUEST_TIMEOUT_SECONDS=45
FURK_CONNECT_TIMEOUT_SECONDS=15
FURK_CREDITS_PAGE_SIZE=100
FURK_CREDITS_MAX_PAGES=1000
FURK_CREDITS_DELAY_MS=100
FURK_CREDITS_MAX_RETRIES=3
FURK_DYNAMIC_STATUS_PAGE_SIZE=500
FURK_DYNAMIC_STATUS_MAX_RETRIES=3
FURK_WEBHOOK_TIMEOUT_SECONDS=240
FURK_MIN_DELAY_BETWEEN_CREATE_REQUESTS_MS=600
FURK_MAX_RECORDS=0
LOG_LEVEL=warning
