# Modelo do .env.test (copie para .env.test e preencha COM OS DADOS DO MYSQL DE TESTE).
# NUNCA aponte para o banco de produção. NUNCA cole este arquivo preenchido em chat/e-mail.
# O nome do banco precisa conter "test" (as ferramentas em tools/ recusam qualquer outro).

MYSQL_HOST=SEU_HOST_DE_TESTE
MYSQL_PORT=3306
MYSQL_DATABASE=furk_cycle_test
MYSQL_USERNAME=SEU_USUARIO_DE_TESTE
MYSQL_PASSWORD=SUA_SENHA_DE_TESTE
MYSQL_CHARSET=utf8mb4
APP_TIMEZONE=America/Sao_Paulo

# OBRIGATORIO nos testes: prefixo dos nomes de GET_LOCK. Os locks valem para o SERVIDOR MySQL inteiro
# (nao por banco); se o banco de teste estiver no mesmo servidor da producao (comum em cPanel), sem prefixo
# os testes poderiam interferir nos locks REAIS das rotinas. O prefixo deve conter "test".
LOCK_PREFIX=test_

# Somente para os testes HTTP (valores quaisquer, apenas de teste):
JWT_SECRET=segredo-de-teste-com-mais-de-32-caracteres-trocar-aqui
JWT_ISSUER=furki-cycle-test
